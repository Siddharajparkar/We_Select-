  },
  "item": [
    {
      "name": "U01 GET /auth/me needs a session",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 401\", function () { pm.response.to.have.status(401); });",
              "pm.test(\"json error.code equals UNAUTHENTICATED\", function () { pm.expect(_.get(pm.response.json(), \"error.code\")).to.eql(\"UNAUTHENTICATED\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "me"
          ]
        }
      }
    },
