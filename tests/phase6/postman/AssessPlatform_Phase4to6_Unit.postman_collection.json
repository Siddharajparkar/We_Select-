    {
      "name": "U13 login with an empty body is a validation error",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"json error.code equals VALIDATION_ERROR\", function () { pm.expect(_.get(pm.response.json(), \"error.code\")).to.eql(\"VALIDATION_ERROR\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "U14 login with an unknown account gives the generic 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 401\", function () { pm.response.to.have.status(401); });",
              "pm.test(\"json error.code equals INVALID_CREDENTIALS\", function () { pm.expect(_.get(pm.response.json(), \"error.code\")).to.eql(\"INVALID_CREDENTIALS\"); });",
              "pm.test(\"body does not contain 'nobody'\", function () { pm.expect(pm.response.text()).to.not.include(\"nobody\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"nobody@p46.example\", \"password\": \"whatever-123\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "U15 creating a tenant without the platform key is refused",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 401\", function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/platform/tenants",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "platform",
            "tenants"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"X\", \"adminName\": \"A\", \"adminEmail\": \"x@p46.example\", \"password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "U16 creating a tenant with a wrong platform key is refused",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 401\", function () { pm.response.to.have.status(401); });",
              "pm.test(\"body does not contain 'wrong-key'\", function () { pm.expect(pm.response.text()).to.not.include(\"wrong-key\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Platform-Key",
            "value": "wrong-key"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/platform/tenants",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "platform",
            "tenants"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"X\", \"adminName\": \"A\", \"adminEmail\": \"x@p46.example\", \"password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "U17 responses carry the version and request id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 401\", function () { pm.response.to.have.status(401); });",
              "pm.test(\"header x-app-version is present\", function () { pm.response.to.have.header(\"x-app-version\"); });",
              "pm.test(\"header x-request-id is present\", function () { pm.response.to.have.header(\"x-request-id\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "me"
          ]
        }
      }
