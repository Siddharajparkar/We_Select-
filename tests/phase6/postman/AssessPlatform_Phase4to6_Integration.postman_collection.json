        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"runId\", pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"json tenantId matches ^[0-9a-f-]{36}$\", function () { pm.expect(String(_.get(pm.response.json(), \"tenantId\"))).to.match(new RegExp(\"^[0-9a-f-]{36}$\")); });",
              "pm.collectionVariables.set(\"tenantIda\", _.get(pm.response.json(), \"tenantId\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Platform-Key",
            "value": "{{platformKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/platform/tenants",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "platform",
            "tenants"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Tenant a {{runId}}\", \"adminName\": \"Admin a\", \"adminEmail\": \"a-{{runId}}@p46.example\", \"password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
