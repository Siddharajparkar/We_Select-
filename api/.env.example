# Copy to .env.local (never commit). Safe local defaults: everything fake / in-memory.
APP_ENV=development
PORT=8080
GIT_SHA=local

REPO_BACKEND=memory          # memory | sql
DB_SCHEMA=assess
DATABASE_URL=                # sql only. ADO.NET style: Server=tcp:<SQL_SERVER>,1433;Database=<DB>;User ID=<APP_USER>;Password=<SET_LOCALLY>;Encrypt=yes

SESSION_SECRET=dev-only-session-secret-change-me-0000
PLATFORM_KEY=dev-only-platform-key-change-me-00000

AI_MODE=fake                 # fake | azure
FOUNDRY_API_STYLE=v1         # v1 | azure-deployments
FOUNDRY_ENDPOINT=
FOUNDRY_KEY=
FOUNDRY_DEPLOYMENT=gpt-4o
FOUNDRY_API_VERSION=
AI_MAX_OUTPUT_TOKENS=2000
AI_DAILY_TOKEN_CAP=200000

EMAIL_MODE=fake              # fake | azure
ACS_CONNECTION_STRING=
ACS_SENDER=

FILES_MODE=memory            # memory | azurite | azure
BLOB_CONNECTION_STRING=
BLOB_CONTAINER=jd-files

APPLICATIONINSIGHTS_CONNECTION_STRING=
APPINSIGHTS_SAMPLING_PERCENT=100

APP_BASE_URL=http://localhost:8080
API_INTERNAL_URL=http://localhost:8080
JOB_LOOP_ENABLED=true

# --- Auth (Phase 4) ---
# Sent as `Secure` cookies; set false ONLY for plain-http local development (production refuses false).
COOKIE_SECURE=true
# Argon2id cost; defaults are the floor from the spec (19 MiB, 2 iterations, 1 lane).
# ARGON2_MEMORY_KIB=19456
# ARGON2_TIME_COST=2
# ARGON2_PARALLELISM=1

# Background jobs and AI limits (Phase 6) - defaults shown
# JOB_LOOP_ENABLED=true
# JOB_MAX_CONCURRENT=3
# JOB_TICK_SECONDS=2
# JOB_STUCK_SECONDS=300
# JOB_RETRY_BASE_SECONDS=5
# JOB_SHUTDOWN_GRACE_SECONDS=20
# AI_TIMEOUT_SECONDS=30
# DAILY_GENERATION_LIMIT=20
# AI_DAILY_TOKEN_CAP=200000

